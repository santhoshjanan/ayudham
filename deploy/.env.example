# Copy to deploy/.env on the server, fill in, and chmod 600. Never commit the copy.
POKERJI_IMAGE=pokerji:1
POKERJI_HOST=poker.example.org

# Existing Docker networks: the one your reverse proxy can reach, and the one shared with
# Postgres and Valkey. The app joins both and publishes no ports.
PROXY_NETWORK=proxy
DATA_NETWORK=shared-data

# The app role (rows only) and the owner role (migrations only). See docs/deploy.md.
# Use passwords of letters and digits only (openssl rand -hex 24): other characters
# break a connection string or this file.
DATABASE_URL=postgres://pokerji_app:CHANGE-ME@postgres:5432/pokerji
MIGRATE_DATABASE_URL=postgres://pokerji_owner:CHANGE-ME@postgres:5432/pokerji
VALKEY_URL=redis://pokerji:CHANGE-ME@valkey:6379
KEY_PREFIX=pokerji:

# 32 or more random characters: openssl rand -base64 48
ADDRESS_HMAC_SECRET=

# 1 when one proxy sits between visitors and the app. Add one for each further proxy or CDN.
XFF_DEPTH=1

# CPUs the app may use.
POKERJI_CPUS=2

RETENTION_DAYS=30
# How many days your Postgres backups are kept. Shown on the privacy page. Leave empty if there are none.
BACKUP_ROTATION_DAYS=
