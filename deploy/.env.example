# Copy to deploy/.env and fill in these four. Never commit the copy.

# The site's host name, without https://
POKERJI_HOST=poker.example.org

# The Docker network your reverse proxy is on. It must already exist: docker network ls
# shows the exact name (compose adds a prefix, for example myproject_proxy).
PROXY_NETWORK=

# Use a password of letters and digits only (openssl rand -hex 24).
DATABASE_URL=postgres://pokerji:CHANGE-ME@postgres:5432/pokerji
VALKEY_URL=redis://:CHANGE-ME@valkey:6379

# Any 32 or more random characters. Leave empty and ./deploy.sh makes one for you.
ADDRESS_HMAC_SECRET=

# ---- Optional. The defaults are fine. ----
# Only if Postgres and Valkey are on a different Docker network from the proxy:
# DATA_NETWORK=
# POKERJI_IMAGE=pokerji:latest
# RETENTION_DAYS=30
# How long your Postgres backups are kept; the privacy page shows it.
# BACKUP_ROTATION_DAYS=14
# Add 1 for each proxy or CDN in front of your reverse proxy.
# XFF_DEPTH=1
# KEY_PREFIX=pokerji:
# POKERJI_CPUS=2
# Optional hardening (docs/deploy.md): a database user that cannot change tables.
# MIGRATIONS=check
# MIGRATE_DATABASE_URL=postgres://pokerji_owner:CHANGE-ME@postgres:5432/pokerji
