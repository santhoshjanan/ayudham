{
  "name": "@pokerji/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node server.js",
    "prepare": "svelte-kit sync || echo ''",
