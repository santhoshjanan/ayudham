    "zod": "4.6.5"
  },
  "devDependencies": {
    "@pokerji/poker-engine": "workspace:*",
    "@pokerji/poker-server": "workspace:*",
    "@pokerji/protocol": "workspace:*",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
