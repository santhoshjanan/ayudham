# Production (docker-compose.yaml) needs these three. Copy this file to .env and fill them in.
# The address people use to reach the site.
ORIGIN=https://poker.example.org
# Any password, letters and digits only.
POSTGRES_PASSWORD=
# 32 or more random characters: openssl rand -hex 24
ADDRESS_HMAC_SECRET=

# Optional: the port the app is published on. Default 3000.
# PORT=3000

# Optional: Prometheus metrics on a second port (docs/deploy.md, "Metrics"). Reach it over
# an internal Docker network only; never publish it or route it through the proxy.
# METRICS_PORT=9464
# METRICS_TOKEN=
# POKERJI_VERSION=1.0.0

# Development (compose-dev.yaml) needs nothing here.
# To run the app outside Docker with `pnpm --filter @pokerji/web dev`, against the
# development Postgres and Valkey, set these instead:
# DATABASE_URL=postgres://pokerji:pokerji_dev@127.0.0.1:5432/pokerji
# VALKEY_URL=redis://:pokerji_dev@127.0.0.1:6379
# ADDRESS_HMAC_SECRET=development-only-address-hmac-secret
